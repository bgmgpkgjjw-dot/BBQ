[Unit]
Description=Hermanos BBQ cook history storage
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@INSTALL_DIR@
Environment=BBQ_STORAGE_PORT=8090
Environment=BBQ_DATA_DIR=@DATA_DIR@
EnvironmentFile=/etc/bbq/bbq.env
ExecStart=/usr/bin/node @INSTALL_DIR@/cook-storage-server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target