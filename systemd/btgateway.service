[Unit]
Description=Hermanos Bluetooth gateway
Wants=network-online.target
After=bluetooth.service network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@INSTALL_DIR@/pi-services/btgateway
ExecStart=@INSTALL_DIR@/pi-services/btgateway/venv/bin/python3 @INSTALL_DIR@/pi-services/btgateway/server.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
