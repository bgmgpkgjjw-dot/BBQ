[Unit]
Description=Hermanos grill WebSocket relay
Wants=network-online.target
After=network-online.target btgateway.service
Requires=btgateway.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@INSTALL_DIR@/pi-services/grill-server
Environment=BBQ_DATA_DIR=@DATA_DIR@
EnvironmentFile=/etc/bbq/bbq.env
ExecStart=/usr/bin/node @INSTALL_DIR@/pi-services/grill-server/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
