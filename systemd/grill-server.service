[Unit]
Description=Hermanos grill WebSocket relay
Wants=network-online.target
After=network-online.target btgateway.service
Requires=btgateway.service

[Service]
Type=simple
User=william
WorkingDirectory=/home/william/grill-server/BBQ/pi-services/grill-server
Environment=BBQ_DATA_DIR=/home/william/bbq-data
EnvironmentFile=/etc/bbq/bbq.env
ExecStart=/usr/bin/node /home/william/grill-server/BBQ/pi-services/grill-server/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
