[Unit]
Description=Hermanos Grill Companion PWA
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=william
WorkingDirectory=/home/william/grill-server/BBQ/pi-services/web-server
EnvironmentFile=/etc/bbq/bbq.env
ExecStart=/usr/bin/node /home/william/grill-server/BBQ/pi-services/web-server/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
